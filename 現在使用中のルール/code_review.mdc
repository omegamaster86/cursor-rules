## 9. 可観測性 👁️

### チェックポイント
- [ ] **構造化ログ**: JSON形式での一貫したログ出力があるか
- [ ] **エラー追跡**: エラーの詳細情報とスタックトレースを記録しているか
- [ ] **パフォーマンス計測**: 重要な処理の実行時間を測定しているか
- [ ] **ビジネスメトリクス**: 重要な業務指標をログに記録しているか
- [ ] **相関ID**: リクエスト間の関連性を追跡できるか

### 良い例
```typescript
// ✅ 可観測性を考慮した実装
export async function updateTrendWord(id: number, data: UpdateData) {
  'use server';
  
  const startTime = Date.now();
  const correlationId = crypto.randomUUID();
  
  try {
    console.log(JSON.stringify({
      event: 'trend_word_update_start',
      correlationId,
      trendWordId: id,
      timestamp: new Date().toISOString()
    }));
    
    const result = await query(
      'UPDATE trend_words SET name = $1 WHERE id = $2',
      [data.name, id]
    );
    
    const duration = Date.now() - startTime;
    console.log(JSON.stringify({
      event: 'trend_word_update_success',
      correlationId,
      trendWordId: id,
      duration,
      timestamp: new Date().toISOString()
    }));
    
    return result;
  } catch (error) {
    console.error(JSON.stringify({
      event: 'trend_word_update_error',
      correlationId,
      trendWordId: id,
      error: error instanceof Error ? error.message : 'Unknown error',
      stack: error instanceof Error ? error.stack : undefined,
      timestamp: new Date().toISOString()
    }));
    throw error;
  }
}
```

